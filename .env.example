
STEAM_API_KEY=YOUR_STEAM_API_KEY
DISCORD_CLIENT_ID=YOUR_CLIENT_ID
# Comma-separated list of Discord server (guild) IDs
DISCORD_GUILD_IDS=YOUR_GUILD_ID_1,YOUR_GUILD_ID_2
DISCORD_TOKEN=YOUR_DISCORD_TOKEN
# Language used for Steam achievement/game data (e.g. english, french)
STEAM_LANG=english
# Set to "true" to (re-)deploy slash commands on container start, e.g. for first deployment
# or after adding/changing commands. Leave unset/false for normal restarts.
DEPLOY_COMMANDS=false
